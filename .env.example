TENDER_USER="your_username_here"
TENDER_PASS="your_password_here"
TARGET_URL="https://tender247.com"
API_ACCESS_KEY="generate_with: python -c \"import secrets; print(secrets.token_urlsafe(32))\""

# Only needed if the scraper runs somewhere that can't also host the API
# (e.g. cPanel) -- pushes tenders_vault.db to the cPanel app's directory
# over SFTP after each scrape run. Leave blank to skip syncing.
CPANEL_SFTP_HOST=""
CPANEL_SFTP_PORT="22"
CPANEL_SFTP_USER=""
CPANEL_SFTP_PASS=""
CPANEL_REMOTE_DB_PATH=""
